---
import BaseLayout from '@layouts/BaseLayout.astro';
import EventCard from '@components/EventCard.astro';
import type { EventData } from '@/types/events';
import { formatTag, getRulesEnforcementLabel } from '@/utils/formatters';

// Load events data from JSON file
let eventsData: EventData | null = null;
let errorMessage: string | null = null;

try {
  const data = await import('../../data/events.json');
  eventsData = data.default as EventData;
} catch (error) {
  console.error('Failed to load events data:', error);
  errorMessage = 'Failed to load events data. Please try again later.';
}

const events = eventsData?.data?.searchEvents?.events || [];
const totalResults = eventsData?.data?.searchEvents?.pageInfo?.totalResults || 0;

// Tags present on every event carry no filtering value
const IGNORED_TAGS = new Set(['magic:_the_gathering', 'standard']);
const RULES_LEVEL_ORDER = ['CASUAL', 'REGULAR', 'COMPETITIVE', 'PROFESSIONAL'];

const filterTags = [...new Set(events.flatMap((event) => event.tags))]
  .filter((tag) => !IGNORED_TAGS.has(tag))
  .sort();
const rulesLevels = [...new Set(events.map((event) => event.rulesEnforcementLevel))].sort(
  (a, b) => RULES_LEVEL_ORDER.indexOf(a) - RULES_LEVEL_ORDER.indexOf(b)
);
---

<BaseLayout 
  title="Standard Events - Alles Standard" 
  description="Browse upcoming Magic: The Gathering Standard format events within 100km of Hamburg, Germany"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Page Header -->
    <div class="mb-8">
      <h1 class="text-4xl md:text-5xl font-extrabold text-white mb-4">
        Standard Events
      </h1>
      <p class="text-xl text-gray-300">
        These are the next events coming up for Standard format within 100km from Hamburg
      </p>
      {totalResults > 0 && (
        <p class="text-mtg-gold font-semibold mt-2" data-results-count data-total={totalResults}>
          {totalResults} event{totalResults !== 1 ? 's' : ''} found
        </p>
      )}
    </div>

    <!-- Error Message -->
    {errorMessage && (
      <div class="bg-red-900/30 border border-red-700 rounded-lg p-6 mb-8">
        <div class="flex items-start">
          <svg class="w-6 h-6 text-red-400 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <div>
            <h3 class="text-lg font-semibold text-white mb-1">Error Loading Events</h3>
            <p class="text-gray-300">{errorMessage}</p>
          </div>
        </div>
      </div>
    )}

    <!-- Filters -->
    {events.length > 0 && (filterTags.length > 0 || rulesLevels.length > 1) && (
      <div class="mb-8 space-y-4" data-event-filters>
        {filterTags.length > 0 && (
          <div>
            <div class="text-gray-400 text-sm mb-2">Event Type</div>
            <div class="flex flex-wrap gap-2">
              {filterTags.map((tag) => (
                <button type="button" class="filter-chip" data-filter-group="tag" data-value={tag} aria-pressed="false">
                  {formatTag(tag)}
                </button>
              ))}
            </div>
          </div>
        )}
        {rulesLevels.length > 1 && (
          <div>
            <div class="text-gray-400 text-sm mb-2">Rules Level</div>
            <div class="flex flex-wrap gap-2">
              {rulesLevels.map((level) => (
                <button type="button" class="filter-chip" data-filter-group="level" data-value={level} aria-pressed="false">
                  {getRulesEnforcementLabel(level)}
                </button>
              ))}
            </div>
          </div>
        )}
      </div>
    )}

    <!-- Events List -->
    {events.length > 0 ? (
      <>
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-1">
          {events.map((event) => (
            <div
              class="min-w-0"
              data-event
              data-tags={event.tags.join(' ')}
              data-level={event.rulesEnforcementLevel}
            >
              <EventCard event={event} />
            </div>
          ))}
        </div>
        <p class="hidden text-center py-16 text-gray-400" data-filter-empty>
          No events match the selected filters.
        </p>
      </>
    ) : !errorMessage && (
      <div class="text-center py-16">
        <svg class="w-16 h-16 text-gray-600 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
        </svg>
        <h2 class="text-2xl font-bold text-white mb-2">No Events Found</h2>
        <p class="text-gray-400">Check back later for upcoming Standard events.</p>
      </div>
    )}

    <!-- Info Box -->
    <div class="mt-12 bg-gradient-to-r from-gray-800 to-gray-900 rounded-lg p-6 border border-gray-700">
      <h3 class="text-lg font-bold text-white mb-2">About These Events</h3>
      <p class="text-gray-300 mb-2">
        Event data is automatically fetched from the official Wizards of the Coast event locator and updated daily.
      </p>
      <p class="text-gray-300">
        Events are shown within a 100km radius of Hamburg and are filtered for Standard format tournaments only.
      </p>
    </div>
  </div>
</BaseLayout>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('[data-filter-group]');
  const cards = document.querySelectorAll<HTMLElement>('[data-event]');
  const count = document.querySelector<HTMLElement>('[data-results-count]');
  const empty = document.querySelector<HTMLElement>('[data-filter-empty]');

  function selected(group: string): string[] {
    return [...chips]
      .filter((chip) => chip.dataset.filterGroup === group && chip.getAttribute('aria-pressed') === 'true')
      .map((chip) => chip.dataset.value!);
  }

  function applyFilters() {
    const tags = selected('tag');
    const levels = selected('level');
    let visible = 0;

    cards.forEach((card) => {
      const cardTags = card.dataset.tags!.split(' ');
      const matchesTag = tags.length === 0 || tags.some((tag) => cardTags.includes(tag));
      const matchesLevel = levels.length === 0 || levels.includes(card.dataset.level!);
      const show = matchesTag && matchesLevel;
      card.hidden = !show;
      if (show) visible++;
    });

    const filtered = tags.length > 0 || levels.length > 0;
    if (count) {
      const total = Number(count.dataset.total);
      count.textContent = filtered
        ? `${visible} of ${total} events shown`
        : `${total} event${total !== 1 ? 's' : ''} found`;
    }
    empty?.classList.toggle('hidden', visible > 0);
  }

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      chip.setAttribute('aria-pressed', String(chip.getAttribute('aria-pressed') !== 'true'));
      applyFilters();
    });
  });
</script>
